#!/bin/sh
set -e

# /usr/lib/nativedev is package-owned.  A root-side maintainer/migration
# process can otherwise leave Python bytecode behind there, which dpkg does
# not own and therefore cannot remove.  Delete only generated bytecode/cache;
# never sweep arbitrary files from the application tree.
cleanup_python_cache() {
    APP_ROOT=/usr/lib/nativedev/app
    [ -d "$APP_ROOT" ] || return 0

    find "$APP_ROOT" -type d -name __pycache__ -prune -exec rm -rf -- {} + 2>/dev/null || true
    find "$APP_ROOT" -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete 2>/dev/null || true
}

cleanup_localdev() {
    # NativeDev's uninstall boundary is intentionally narrow: only the core
    # Local Development integration is removed.  Standalone service/tool
    # integrations (.localhost tools, Mailpit, PHP INI, databases, etc.) are
    # preserved.
    rm -f \
        /etc/NetworkManager/conf.d/nativedev-dns.conf \
        /etc/NetworkManager/dnsmasq.d/nativedev-test.conf

    if command -v nmcli >/dev/null 2>&1; then
        nmcli general reload conf >/dev/null 2>&1 || true
        nmcli general reload dns-full >/dev/null 2>&1 || true
    fi

    rm -f \
        /etc/nginx/sites-enabled/nativedev-sites.conf \
        /etc/nginx/sites-available/nativedev-sites.conf

    if command -v nginx >/dev/null 2>&1 \
        && command -v systemctl >/dev/null 2>&1 \
        && systemctl is-active --quiet nginx 2>/dev/null \
        && nginx -t >/dev/null 2>&1; then
        systemctl reload nginx >/dev/null 2>&1 || true
    fi
}

# Safe for remove and upgrade: bytecode is disposable package-runtime state.
cleanup_python_cache

case "${1:-}" in
    remove|deconfigure)
        cleanup_localdev
        ;;
    upgrade|failed-upgrade|*)
        # Never tear down LocalDev while replacing/upgrading the package.
        ;;
esac

exit 0
